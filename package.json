{
  "name": "@carizon/board-session",
  "version": "0.1.0",
  "description": "Persistent local wolfSSH X.509 sessions through zero or more SSH jumps",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "prepack": "npm run build:ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
